# ── YAYIN İMZALAMA ANAHTARI ─────────────────────────────────────────────────
# Bu dosyayı 'keystore.properties' olarak KOPYALA ve kendi değerlerinle doldur.
# ASLA git'e ekleme, ASLA kaybetme (yedekle!). Bu anahtar uygulamanın kimliğidir.
#
# Anahtar oluşturma komutu (bir kez, kendi bilgisayarında):
#   keytool -genkey -v -keystore horse-runner-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Sonra .jks dosyasını android/ klasörüne koy ve aşağıyı doldur:
storeFile=horse-runner-upload.jks
storePassword=BURAYA_KEYSTORE_SIFRESI
keyAlias=upload
keyPassword=BURAYA_ANAHTAR_SIFRESI
